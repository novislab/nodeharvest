{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "*": "ask",
        "laravel-boost": "ask",
        "instruckt": "ask"
    },
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "instruckt": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "/home/novistech/laravel/nodeharvest/artisan",
                "mcp:start",
                "instruckt"
            ]
        }
    }
}
